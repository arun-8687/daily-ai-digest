{
  "name": "triage",
  "version": "1.0.0",
  "description": "Triage: a real-time incident board. TypeScript end to end (React + Vite, Node, SQLite).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "seed": "node --disable-warning=ExperimentalWarning --import tsx tools/seed.ts",
    "simulate": "node --disable-warning=ExperimentalWarning --import tsx tools/simulate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
